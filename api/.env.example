# Configure at least one provider. Never publish these credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
# Your Discord snowflake. Join the Lanyard server to enable presence tracking.
DISCORD_USER_ID=
# Optional PC reporting. Use the same key on the server and Linux client.
# Generate at least 32 random bytes, for example: openssl rand -base64 48
SIGNING_KEY=
PC_ID=main

# Public DevJourney GitHub contents proxy. Only use a token for a public repo.
DEVJOURNEY_REPO_OWNER=upayanmazumder
DEVJOURNEY_REPO_NAME=DevJourney
# Optional dedicated, read-only token to increase GitHub API limits.
DEVJOURNEY_GITHUB_TOKEN=

# GitHub contribution calendar. Token needs the read:user scope.
# Enable "Private contributions" on your GitHub profile to include private counts.
GITHUB_TOKEN=
GITHUB_USER=upayanmazumder

# Default bind is loopback. Set BIND_HOST=0.0.0.0 behind a TLS reverse proxy.
BIND_HOST=127.0.0.1
PORT=8080
# Set this to the exact website origin when the browser calls the API directly.
CORS_ORIGIN=
